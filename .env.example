# Copy to .env and fill in what you have. Everything is optional:
# without keys the app runs fully offline with deterministic local
# providers (mock LLM + hashed embeddings + local vector store).

# --- OpenAI (enables real LLM + real embeddings) ---------------------
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (enables the real vector store) ------------------------
PINECONE_API_KEY=
PINECONE_INDEX=retail-support
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Providers: auto | openai/pinecone | mock/local -------------------
# auto = use the real service when its key is set, else local fallback.
LLM_PROVIDER=auto
VECTOR_BACKEND=auto
EMBEDDING_PROVIDER=auto

# --- RAG --------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
MIN_RETRIEVAL_SCORE=0.15

# --- Agent --------------------------------------------------------------
PROMPT_VERSION=v2
MAX_TOOL_ITERATIONS=4

# --- App ------------------------------------------------------------------
LOG_LEVEL=INFO
# DATABASE_URL=sqlite:///backend/retail_support.db
# CORS_ORIGINS=http://localhost:5173
